# Copy this file to .env and set a strong, unique password.
OPENCHAMBER_UI_PASSWORD=change-this-before-starting
OPENCHAMBER_SOURCE_DIR=./openchamber
OPENCHAMBER_BIND_ADDRESS=127.0.0.1
OPENCHAMBER_PORT=3001
OPENCHAMBER_CONTAINER_NAME=openchamber

FORGEJO_DOMAIN=forgejo.test
FORGEJO_IP=127.0.0.1

# Relative paths are relative to this directory.
OPENCHAMBER_CONFIG_DIR=./data/openchamber
OPENCODE_SHARE_DIR=./data/opencode/share
OPENCODE_STATE_DIR=./data/opencode/state
OPENCODE_CONFIG_DIR=./data/opencode/config
OPENCHAMBER_SSH_DIR=./data/ssh
OPENCHAMBER_WORKSPACES_DIR=./workspaces

# Optional official runtime settings.
OH_MY_OPENCODE=false
# OPENCHAMBER_TUNNEL_PROVIDER=cloudflare
# OPENCHAMBER_TUNNEL_MODE=quick
# OPENCHAMBER_TUNNEL_HOSTNAME=app.example.com
# OPENCHAMBER_TUNNEL_TOKEN=replace-me
# OPENCHAMBER_TUNNEL_CONFIG=/home/openchamber/.cloudflared/config.yml
# OPENCODE_HOST=http://host.docker.internal:4096
# OPENCODE_SKIP_START=true
# OPENCHAMBER_OPENCODE_HOSTNAME=0.0.0.0
